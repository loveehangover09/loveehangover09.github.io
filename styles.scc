:root {
  --ink: #09090c;
  --paper: #f5f1e8;
  --card: #fffdf7;
  --pink: #ff4f91;
  --pink-soft: #ffd4e5;
  --yellow: #ffe04b;
  --muted: #625f67;
  --border: 3px solid var(--ink);
  --shadow: 8px 8px 0 var(--ink);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: "Inter", sans-serif;
  overflow-x: hidden;
  transition: background .35s, color .35s;
}
body.no-scroll { overflow: hidden; }
a { color: inherit; text-decoration: none; }
button { font: inherit; }

.intro {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-content: center;
  justify-items: center;
  overflow: hidden;
  background: #060608;
  color: white;
  text-align: center;
  transition: opacity .7s ease, visibility .7s ease;
}
.intro::before, .intro::after {
  content: "";
  position: absolute;
  width: 130%;
  height: 32%;
  background: var(--pink);
  border: 8px solid white;
  transform: rotate(-8deg) translateY(-230%);
}
.intro::after { transform: rotate(-8deg) translateY(230%); background: var(--yellow); }
.intro-rays {
  position: absolute;
  inset: -50%;
  background: repeating-conic-gradient(from 0deg, transparent 0 7deg, rgba(255,255,255,.06) 7deg 12deg);
  animation: spin 28s linear infinite;
}
.intro-kicker { z-index: 1; margin: 0 0 10px; font-weight: 800; letter-spacing: .35em; font-size: .72rem; }
.intro h1 { z-index: 1; margin: 0; font-family: "Bangers", Impact, sans-serif; font-size: clamp(4.3rem, 13vw, 10rem); line-height: .8; letter-spacing: .035em; text-shadow: 7px 7px 0 var(--pink); transform: rotate(-2deg); }
.intro h1 span { color: var(--yellow); text-shadow: 7px 7px 0 var(--pink); }
.enter-button { z-index: 1; margin-top: 45px; padding: 15px 22px; color: var(--ink); background: white; border: 3px solid white; box-shadow: 7px 7px 0 var(--pink); font-weight: 900; cursor: pointer; transform: rotate(1deg); transition: .2s; }
.enter-button:hover { transform: translate(4px, 4px) rotate(-1deg); box-shadow: 3px 3px 0 var(--pink); }
.intro-hint { z-index: 1; margin-top: 20px; font-size: .7rem; letter-spacing: .2em; opacity: .55; }
.intro.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
.intro.is-leaving h1 { animation: introExit .65s cubic-bezier(.2,.8,.2,1) forwards; }

.site-header {
  position: fixed;
  z-index: 100;
  top: 0;
  left: 0;
  right: 0;
  height: 72px;
  display: flex;
  align-items: center;
  gap: 28px;
  padding: 0 4vw;
  color: white;
  background: rgba(9,9,12,.88);
  border-bottom: 2px solid rgba(255,255,255,.18);
  backdrop-filter: blur(13px);
}
.logo { margin-right: auto; font-family: "Bangers", Impact, sans-serif; font-size: 1.45rem; letter-spacing: .08em; }
.logo span { color: var(--pink); }
.nav { display: flex; gap: 24px; font-size: .72rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
.nav a { position: relative; padding: 8px 0; }
.nav a::after { content: ""; position: absolute; left: 0; right: 100%; bottom: 2px; height: 3px; background: var(--pink); transition: right .2s; }
.nav a:hover::after { right: 0; }
.header-actions { display: flex; gap: 9px; }
.theme-toggle, .menu-toggle { height: 38px; border: 2px solid white; color: white; background: transparent; cursor: pointer; font-weight: 900; }
.theme-toggle { width: 48px; position: relative; }
.theme-toggle span { position: absolute; inset: 0; display: grid; place-items: center; transition: .25s; }
.theme-toggle .sun { opacity: 0; transform: rotate(-90deg) scale(.3); }
.menu-toggle { display: none; padding: 0 12px; font-size: .7rem; }

.hero {
  min-height: 100vh;
  position: relative;
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  align-items: center;
  gap: 4vw;
  padding: 120px 7vw 80px;
  overflow: hidden;
  background: var(--ink);
  color: white;
}
.hero::after { content: ""; position: absolute; top: 0; right: 0; width: 42%; height: 100%; background: var(--pink); clip-path: polygon(30% 0,100% 0,100% 100%,0 100%); }
.speed-lines { position: absolute; inset: 0; opacity: .08; background: repeating-linear-gradient(112deg, transparent 0 20px, white 21px 23px, transparent 24px 65px); }
.hero-content, .hero-art { position: relative; z-index: 2; }
.eyebrow { display: flex; align-items: center; gap: 10px; font-size: .72rem; font-weight: 800; letter-spacing: .16em; }
.eyebrow span { display: grid; place-items: center; width: 34px; height: 34px; background: var(--yellow); color: var(--ink); border: 2px solid white; transform: rotate(-6deg); }
.speech-bubble { display: inline-block; position: relative; margin: 28px 0 12px; padding: 9px 15px; background: white; color: var(--ink); border: 3px solid var(--ink); box-shadow: 4px 4px 0 var(--pink); font-weight: 900; transform: rotate(-2deg); }
.speech-bubble::after { content: ""; position: absolute; bottom: -14px; left: 28px; width: 18px; height: 18px; background: white; border-right: 3px solid var(--ink); border-bottom: 3px solid var(--ink); transform: skewY(-35deg); }
.hero h1 { margin: 10px 0 25px; font-family: "Bangers", Impact, sans-serif; font-size: clamp(4.2rem, 8vw, 8.5rem); line-height: .83; letter-spacing: .025em; }
.hero h1 em { color: var(--pink); font-style: normal; -webkit-text-stroke: 1px white; text-shadow: 5px 5px 0 rgba(255,255,255,.16); }
.hero-copy { max-width: 610px; line-height: 1.8; color: #c9c6ce; }
.comic-button { display: inline-flex; align-items: center; gap: 25px; margin-top: 22px; padding: 14px 18px; background: var(--yellow); color: var(--ink); border: 3px solid white; box-shadow: 6px 6px 0 var(--pink); font-weight: 900; font-size: .8rem; transition: .2s; }
.comic-button:hover { transform: translate(4px,4px); box-shadow: 2px 2px 0 var(--pink); }
.hero-art { min-height: 530px; display: grid; place-items: center; }
.sun-disc { position: absolute; width: min(35vw, 480px); aspect-ratio: 1; border-radius: 50%; background: var(--yellow); border: 6px solid var(--ink); box-shadow: 0 0 0 12px white, 0 0 0 18px var(--ink); }
.panel-card { position: relative; width: min(28vw, 390px); min-width: 280px; aspect-ratio: .72; display: grid; place-content: center; text-align: center; background: #111116; border: 6px solid white; box-shadow: 14px 14px 0 var(--ink); transform: rotate(5deg); overflow: hidden; }
.panel-card::before { content: ""; position: absolute; inset: 0; opacity: .12; background: radial-gradient(circle, white 1px, transparent 1.5px); background-size: 10px 10px; }
.panel-card p { position: relative; margin: 18px 0 0; font-family: "Bangers"; font-size: 3rem; line-height: .9; letter-spacing: .08em; }
.panel-no { position: absolute; top: 14px; left: 14px; padding: 7px 10px; color: var(--ink); background: var(--yellow); font-size: .7rem; font-weight: 900; }
.code-face { position: relative; font-family: "Bangers"; font-size: 6.5rem; color: var(--pink); text-shadow: 5px 5px white; }
.sound-effect { position: absolute; right: -2%; bottom: 4%; font-family: "Bangers"; font-size: 2.8rem; color: white; transform: rotate(-13deg); -webkit-text-stroke: 2px var(--ink); text-shadow: 4px 4px 0 var(--yellow); }
.scroll-cue { position: absolute; z-index: 3; left: 3vw; bottom: 26px; font-size: .65rem; letter-spacing: .2em; font-weight: 700; writing-mode: vertical-rl; }
.scroll-cue span { color: var(--pink); font-size: 1.2rem; }

.section { position: relative; padding: 110px 7vw; }
.section-heading { margin-bottom: 45px; }
.chapter { margin: 0 0 7px; color: var(--pink); font-size: .72rem; letter-spacing: .22em; font-weight: 900; }
.section-heading h2 { margin: 0; font-family: "Bangers"; font-size: clamp(3.7rem, 7vw, 7rem); letter-spacing: .045em; line-height: .88; }
.section-heading h2 span { color: var(--pink); }
.section-heading.light { color: white; }
.comic-grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: 35px; }
.manga-panel { position: relative; padding: clamp(28px,4vw,58px); background: var(--card); border: var(--border); box-shadow: var(--shadow); overflow: hidden; }
.manga-panel::after { content: ""; position: absolute; width: 180px; height: 180px; right: -50px; bottom: -50px; background: radial-gradient(circle, var(--pink) 1.2px, transparent 1.8px); background-size: 9px 9px; opacity: .3; }
.panel-tag { position: absolute; top: 0; right: 0; padding: 7px 14px; color: white; background: var(--ink); font-family: "Bangers"; letter-spacing: .12em; }
.bio-panel .lead { max-width: 760px; margin-top: 0; font-size: clamp(1.7rem,3vw,3rem); line-height: 1.2; font-weight: 800; }
.bio-panel p:not(.lead) { max-width: 720px; line-height: 1.85; color: var(--muted); }
.ink-note { display: inline-block; margin-top: 18px; padding: 8px 12px; background: var(--yellow); border: 2px solid var(--ink); font-family: "Bangers"; font-size: 1.3rem; transform: rotate(-2deg); }
.status-panel { background: var(--pink-soft); }
.stat { position: relative; z-index: 1; padding: 17px 0; border-bottom: 2px solid var(--ink); }
.stat span { display: block; margin-bottom: 6px; font-size: .65rem; letter-spacing: .15em; text-transform: uppercase; color: var(--muted); }
.stat strong { font-size: 1.05rem; }

.courses, .projects { background: var(--ink); }
.course-list { display: grid; grid-template-columns: repeat(5,1fr); gap: 14px; }
.course-card { position: relative; min-height: 315px; padding: 28px 22px; background: white; border: 3px solid white; box-shadow: 7px 7px 0 var(--pink); overflow: hidden; transition: .25s; }
.course-card:nth-child(even) { margin-top: 25px; background: var(--yellow); }
.course-card:hover { transform: translateY(-9px) rotate(-1deg); }
.course-card > span { position: absolute; right: -7px; top: -25px; color: rgba(9,9,12,.08); font-family: "Bangers"; font-size: 8rem; }
.course-card h3 { position: relative; margin: 90px 0 16px; font-family: "Bangers"; font-size: 2.2rem; line-height: .9; letter-spacing: .04em; }
.course-card p { position: relative; font-size: .8rem; line-height: 1.6; color: #4b4850; }

.lab { background-image: radial-gradient(rgba(9,9,12,.12) 1.3px, transparent 1.3px); background-size: 12px 12px; }
.lab-layout { display: grid; grid-template-columns: 1.15fr .85fr; gap: 45px; align-items: center; }
.terminal { color: #e8e8e8; background: #111117; border: 4px solid var(--ink); box-shadow: 10px 10px 0 var(--pink); }
.terminal-bar { display: flex; align-items: center; gap: 8px; padding: 12px 15px; border-bottom: 2px solid #33333c; background: #1d1d25; }
.terminal-bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--pink); }
.terminal-bar i:nth-child(2) { background: var(--yellow); }.terminal-bar i:nth-child(3) { background: #53d98b; }
.terminal-bar span { margin-left: 8px; color: #8e8d97; font-size: .7rem; }
.terminal-body { min-height: 380px; padding: 30px; font: 500 .9rem/1.7 ui-monospace, SFMono-Regular, Menlo, monospace; }
.terminal-body b { color: var(--pink); }.terminal-body .output { padding-left: 20px; color: #74e6a4; }
.cursor span { display: inline-block; width: 9px; height: 17px; vertical-align: middle; background: white; animation: blink .9s steps(1) infinite; }
.lab-note { position: relative; padding: 60px 35px 35px; background: var(--yellow); border: var(--border); box-shadow: var(--shadow); transform: rotate(2deg); }
.lab-note h3 { font-family: "Bangers"; font-size: 2.7rem; letter-spacing: .05em; }
.lab-note p { line-height: 1.75; }
.burst { position: absolute; top: -28px; right: 25px; display: grid; place-items: center; width: 90px; height: 90px; background: var(--pink); color: white; clip-path: polygon(50% 0,61% 25%,83% 9%,78% 35%,100% 37%,80% 53%,96% 70%,71% 69%,73% 100%,53% 78%,38% 98%,34% 73%,7% 85%,25% 61%,0 48%,26% 42%,8% 20%,38% 28%); font-family: "Bangers"; font-size: 1.7rem; transform: rotate(-8deg); }
.protocols { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 25px; }
.protocols span { padding: 7px 9px; color: white; background: var(--ink); font-size: .65rem; font-weight: 900; }

.project-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
.project-card { position: relative; background: white; border: 4px solid white; box-shadow: 9px 9px 0 var(--pink); transition: .25s; }
.project-card:hover { transform: translateY(-7px); }
.project-number { position: absolute; z-index: 2; top: -16px; left: 18px; padding: 8px 15px; background: var(--yellow); color: var(--ink); border: 3px solid var(--ink); font: 2rem "Bangers"; }
.project-visual { height: 260px; display: grid; place-content: center; gap: 10px; overflow: hidden; background: var(--pink); color: white; border-bottom: 4px solid var(--ink); font: 2.4rem "Bangers"; text-align: center; }
.project-visual.web span { display: block; padding: 4px 18px; background: var(--ink); border: 2px solid white; transform: rotate(-3deg); }
.project-visual.web span:nth-child(2) { transform: rotate(3deg); background: white; color: var(--ink); }
.project-visual.packet { grid-template-columns: auto auto auto; align-items: center; background: var(--yellow); color: var(--ink); }
.project-visual.packet span { padding: 15px; border: 3px solid var(--ink); background: white; }.project-visual.packet i { font-size: 2rem; }
.project-visual.packet .locked { background: var(--ink); color: white; }
.project-info { padding: 30px; color: var(--ink); }
.project-info > p:first-child { color: var(--pink); font-size: .65rem; font-weight: 900; letter-spacing: .16em; }
.project-info h3 { margin: 9px 0 15px; font-size: 1.5rem; }
.project-info > p:last-child { color: #605d65; line-height: 1.7; }

.contact { position: relative; min-height: 620px; display: grid; place-items: center; padding: 100px 7vw; overflow: hidden; background: var(--pink); color: white; text-align: center; }
.contact-burst { position: absolute; width: 1100px; aspect-ratio: 1; background: repeating-conic-gradient(var(--yellow) 0 5deg, transparent 5deg 11deg); animation: spin 55s linear infinite; opacity: .65; }
.contact-content { position: relative; z-index: 1; }
.contact-content > p { font-size: .7rem; font-weight: 900; letter-spacing: .3em; }
.contact h2 { margin: 15px 0 40px; font: clamp(5rem,11vw,11rem)/.7 "Bangers"; letter-spacing: .05em; -webkit-text-stroke: 3px var(--ink); text-shadow: 7px 7px 0 var(--ink); }
.contact h2 span { color: var(--yellow); }
.contact-links { display: flex; justify-content: center; gap: 20px; }
.contact-links a { min-width: 250px; padding: 16px 18px; display: grid; grid-template-columns: 1fr auto; align-items: center; text-align: left; background: white; color: var(--ink); border: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); font-weight: 800; transition: .2s; }
.contact-links a:hover { transform: translate(4px,4px); box-shadow: 2px 2px 0 var(--ink); }
.contact-links small { grid-column: 1 / -1; color: var(--pink); font-size: .58rem; letter-spacing: .16em; }
.contact-links b { font-size: 1.3rem; }
footer { display: flex; justify-content: space-between; padding: 24px 4vw; color: #85828b; background: var(--ink); font-size: .65rem; letter-spacing: .12em; }

.sakura-layer { position: fixed; z-index: 90; inset: 0; pointer-events: none; overflow: hidden; }
.petal { position: absolute; top: -70px; width: var(--size); height: calc(var(--size) * .72); border-radius: 70% 18% 70% 28%; background: radial-gradient(circle at 68% 68%, #ff6fa8 0 10%, transparent 11%), linear-gradient(145deg, #fff8fb 0%, #ffd2e3 48%, #ff78ac 100%); box-shadow: inset -2px -2px 4px rgba(194,35,96,.18), 0 2px 3px rgba(0,0,0,.16); opacity: var(--opacity); transform-origin: 80% 80%; animation: fall var(--duration) linear var(--delay) infinite; }
.sakura-branches { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
.sakura-photo { position: absolute; top: 0; width: min(43vw, 680px); height: 48vh; min-height: 360px; object-fit: cover; object-position: 50% 58%; mix-blend-mode: screen; opacity: .92; filter: saturate(1.12) contrast(1.08); -webkit-mask-image: radial-gradient(ellipse at center, #000 36%, transparent 76%); mask-image: radial-gradient(ellipse at center, #000 36%, transparent 76%); }
.sakura-photo-left { left: -8vw; transform: rotate(12deg); transform-origin: left top; }
.sakura-photo-right { right: -8vw; transform: scaleX(-1) rotate(12deg); transform-origin: right top; }
.reveal { opacity: 0; transform: translateY(34px); transition: opacity .75s ease, transform .75s ease; }
.reveal.visible { opacity: 1; transform: translateY(0); }

body.light-theme { --paper: #fffaf3; --card: #fff; }
body.light-theme .site-header { color: var(--ink); background: rgba(255,250,243,.9); border-color: rgba(9,9,12,.18); }
body.light-theme .theme-toggle, body.light-theme .menu-toggle { color: var(--ink); border-color: var(--ink); }
body.light-theme .theme-toggle .moon { opacity: 0; transform: rotate(90deg) scale(.3); }
body.light-theme .theme-toggle .sun { opacity: 1; transform: rotate(0) scale(1); }

@keyframes spin { to { transform: rotate(360deg); } }
@keyframes blink { 50% { opacity: 0; } }
@keyframes introExit { to { transform: scale(1.9) rotate(3deg); opacity: 0; } }
@keyframes fall {
  0% { transform: translate3d(0,-8vh,0) rotate(0deg) rotateY(0); }
  25% { transform: translate3d(var(--drift-a),26vh,0) rotate(130deg) rotateY(100deg); }
  55% { transform: translate3d(var(--drift-b),58vh,0) rotate(260deg) rotateY(210deg); }
  100% { transform: translate3d(var(--drift-c),115vh,0) rotate(540deg) rotateY(360deg); }
}

@media (max-width: 1000px) {
  .nav { display: none; position: absolute; top: 72px; left: 0; right: 0; padding: 25px 4vw; flex-direction: column; background: #111116; color: white; border-bottom: 3px solid var(--pink); }
  .nav.open { display: flex; }.menu-toggle { display: block; }
  .hero { grid-template-columns: 1fr; padding-top: 135px; }.hero::after { width: 100%; height: 46%; top: auto; bottom: 0; clip-path: polygon(0 23%,100% 0,100% 100%,0 100%); }
  .hero-art { min-height: 500px; }.panel-card { width: 320px; }
  .comic-grid, .lab-layout { grid-template-columns: 1fr; }
  .course-list { grid-template-columns: repeat(3,1fr); }.course-card:nth-child(even) { margin-top: 0; }
}

@media (max-width: 680px) {
  .site-header { height: 64px; padding: 0 18px; }.nav { top: 64px; }
  .hero { padding: 112px 22px 75px; }.hero h1 { font-size: 4.1rem; }
  .hero-art { min-height: 420px; }.sun-disc { width: 280px; }.panel-card { min-width: 230px; width: 245px; }.panel-card p { font-size: 2.2rem; }.code-face { font-size: 5rem; }
  .section { padding: 85px 22px; }.course-list, .project-grid { grid-template-columns: 1fr; }.course-card { min-height: 240px; }.course-card h3 { margin-top: 55px; }
  .contact { padding: 80px 22px; }.contact h2 { font-size: 5.1rem; }.contact-links { flex-direction: column; }.contact-links a { min-width: min(280px,80vw); }
  footer { flex-direction: column; gap: 8px; text-align: center; }
  .intro h1 { font-size: 4.7rem; }.project-visual.packet { font-size: 1.4rem; }.project-visual.packet span { padding: 10px 6px; }
  .sakura-photo { width: 72vw; height: 38vh; min-height: 280px; opacity: .86; }
  .sakura-photo-left { left: -38vw; }
  .sakura-photo-right { right: -38vw; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; } *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }.petal { display: none; }.reveal { opacity: 1; transform: none; }
}
